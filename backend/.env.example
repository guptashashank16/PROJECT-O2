# Q-CARE Platform Environment Configuration Example
# Copy this file to .env and configure local development values

# Server Network Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# Set to 'production' to enable stricter security checks (JWT validation, docs lockdown)
ENVIRONMENT=development

# CORS allowed origins for local development
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Security & JWT Authentication
# Local development signing secret. Use a private random value if needed.
JWT_SECRET_KEY=local-development-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# QML Computational Simulation Defaults
FAST_DEMO_MODE=true
DEFAULT_QUANTUM_QUBITS=6
DEFAULT_VQC_LAYERS=2
DEFAULT_VQC_MAX_ITER=25
RANDOM_SEED=42

# Dataset Upload Safeguards
MAX_UPLOAD_SIZE_MB=15
MAX_UPLOAD_ROWS=50000
MAX_UPLOAD_COLUMNS=500
