# Q-CARE Platform Environment Configuration Example
# Copy this file to .env and configure appropriate values for deployment

# Server Network Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# Set to 'production' in Vercel / Docker to enable stricter security checks (JWT validation, docs lockdown)
ENVIRONMENT=development

# CORS Allowed Origins (Comma-separated or JSON list in production)
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Security & JWT Authentication
# CRITICAL: Replace with a secure random string in production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# QML Computational Simulation Defaults
FAST_DEMO_MODE=true
DEFAULT_QUANTUM_QUBITS=6
DEFAULT_VQC_LAYERS=2
DEFAULT_VQC_MAX_ITER=25
RANDOM_SEED=42

# Dataset Upload Safeguards
MAX_UPLOAD_SIZE_MB=15
MAX_UPLOAD_ROWS=50000
MAX_UPLOAD_COLUMNS=500
